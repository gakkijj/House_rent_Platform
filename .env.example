# 不要提交 .env；它包含本地数据库密码。
HOUSERENT_MYSQL_ROOT_PASSWORD=change-this-to-a-strong-local-password
MYSQL_DATABASE=houserent

# Windows 上的旧 MySQL 仍使用 3306；容器 MySQL 默认暴露到 3307，避免冲突。
MYSQL_HOST_PORT=3307
API_PORT=9998
WEB_PORT=9999

# WSL 中 Windows 用户目录的上传文件位置；容器会映射为 /root/uploads。
UPLOADS_HOST_PATH=/mnt/c/Users/your-windows-user/uploads
